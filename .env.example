# Copy this file to .env and fill it in. Never commit .env.

# Free Helius API key. Optional in Phases 0-1 (the live feed uses the public Solana
# WebSocket); used later for RPC lookups. Get one at https://dashboard.helius.dev
HELIUS_API_KEY=

# Your wallet's PUBLIC address only (used from Phase 13 to read your own trades from chain).
# Never put a private key or seed phrase anywhere in this project.
MY_WALLET_PUBLIC_ADDRESS=

# Folder for recorded data, logs and run files. Empty = ./data inside the project.
DATA_DIR=

# Optional, later phases:
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
